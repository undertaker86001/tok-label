# ===========================================
# TOKLABEL 数据库配置示例
# ===========================================

# 数据库类型选择: 'postgresql' 或 'doris'
DATABASE_TYPE=postgresql

# ===========================================
# PostgreSQL 配置
# ===========================================
POSTGRE_HOST=localhost
POSTGRE_PORT=5432
POSTGRE_USER=postgres
POSTGRE_PASSWORD=your_postgres_password
POSTGRE_DATABASE=toklabel_db

# PostgreSQL 性能配置
POSTGRES_QUERY_TIMEOUT=300
POSTGRES_BATCH_SIZE=1000

# ===========================================
# Doris 配置
# ===========================================
DORIS_FE_HOST=localhost
DORIS_FE_PORT=9030
DORIS_USER=root
DORIS_PASSWORD=your_doris_password
DORIS_DATABASE=toklabel_db

# Doris 性能配置
DORIS_QUERY_TIMEOUT=300
DORIS_BATCH_SIZE=1000

# ===========================================
# 连接池配置
# ===========================================
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30

# ===========================================
# 功能开关
# ===========================================
ENABLE_QUERY_CACHE=false
ENABLE_CONNECTION_POOLING=true
ENABLE_QUERY_LOGGING=false

# ===========================================
# Label Studio 配置
# ===========================================
LABEL_STUDIO_URL=http://localhost:8080
LABEL_STUDIO_API_KEY=your_api_key_here

# ===========================================
# 服务配置
# ===========================================
FILE_SERVER_URL=http://localhost:8000
EXTRACTOR_SERVER_URL=http://localhost:8001

# ===========================================
# Redis 配置
# ===========================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password
REDIS_DB=0

  "database": {
    "engine": "django.db.backends.postgresql",
    "name": "label_studio",
    "user": "labelstudio",
    "password": "labelstudio123",
    "host": "postgres",
    "port": 5432,
    "options": {
      "sslmode": "disable"
    }
  },
  "redis": {
    "host": "redis",
    "port": 6379,
    "db": 0,
    "password": null,
    "ssl": false,
    "ssl_cert_reqs": "required",
    "ssl_ca_certs": null,
    "ssl_certfile": null,
    "ssl_keyfile": null,
    "ssl_check_hostname": true,
    "connection_pool_class": "redis.connection.BlockingConnectionPool",
    "max_connections": 50,
    "retry_on_timeout": true,
    "health_check_interval": 30,
    "socket_connect_timeout": 5,
    "socket_timeout": 5,
    "socket_keepalive": false,
    "socket_keepalive_options": {},
    "socket_type": 0,
    "socket_keepalive_idle": 1,
    "socket_keepalive_interval": 1,
    "socket_keepalive_count": 1
  },
  "storage": {
    "backend": "django.core.files.storage.FileSystemStorage",
    "options": {
      "location": "/data/media",
      "base_url": "/media/"
    }
  },
  "static": {
    "backend": "django.contrib.staticfiles.storage.StaticFilesStorage",
    "options": {
      "location": "/data/static",
      "base_url": "/static/"
    }
  },
  "sessions": {
    "backend": "django.contrib.sessions.backends.db",
    "options": {
      "table_name": "django_session"
    }
  },
  "cache": {
    "backend": "django.core.cache.backends.redis.RedisCache",
    "options": {
      "location": "redis://redis:6379/1"
    }
  },
  "celery": {
    "broker_url": "redis://redis:6379/2",
    "result_backend": "redis://redis:6379/3",
    "task_serializer": "json",
    "accept_content": ["json"],
    "result_serializer": "json",
    "timezone": "UTC",
    "enable_utc": true,
    "task_track_started": true,
    "task_time_limit": 30 * 60,
    "task_soft_time_limit": 60,
    "worker_prefetch_multiplier": 1,
    "worker_max_tasks_per_child": 1000,
    "worker_disable_rate_limits": false,
    "worker_proc_alive_timeout": 60.0,
    "worker_send_task_events": true,
    "worker_store_errors_even_if_ignored": true,
    "worker_log_format": "[%(asctime)s: %(levelname)s/%(processName)s] %(message)s",
    "worker_task_log_format": "[%(asctime)s: %(levelname)s/%(processName)s] [%(task_name)s(%(task_id)s)] %(message)s",
    "worker_redirect_stdouts": true,
    "worker_redirect_stdouts_level": "WARNING",
    "worker_pool_restarts": true,
    "worker_cancel_long_running_tasks_on_connection_loss": true,
    "worker_enable_remote_control": true,
    "worker_pool": "prefork",
    "worker_concurrency": 4,
